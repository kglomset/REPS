# Caddy reverse proxy for repstracker.no
# - Serves the Expo web frontend at the domain root
# - Proxies /api/* to the Spring Boot backend (whose context-path is /api,
#   so the prefix is intentionally NOT stripped)
# - Automatic HTTPS via Let's Encrypt (needs ports 80 + 443 reachable)

repstracker.no {
	encode gzip

	# Backend API — keep the /api prefix so Spring's context-path matches
	reverse_proxy /api/* backend:8080

	# Everything else → Expo web build (nginx container)
	reverse_proxy frontend:80
}

# Redirect the bare www host to the apex (optional; safe to keep)
www.repstracker.no {
	redir https://repstracker.no{uri} permanent
}
