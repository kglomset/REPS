# ── Stage 1: build the Expo web bundle ────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies first (better layer caching)
COPY package*.json ./
RUN npm ci

# Copy source and export
COPY . .

# API URL is baked in at build time (Expo public env vars are static)
ARG EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL

RUN npx expo export --platform web

# ── Diagnostic overlay ────────────────────────────────────────────────────────
# If the app fails to boot on a client (JS error, a 404'd chunk from a stale
# cache, etc.) the page would otherwise just be blank with nothing to debug.
# This inlines error/rejection listeners plus an 8s "nothing rendered" check as
# the very first thing in <head>, before the app's own bundle script tag, so it
# can catch failures the app's own JS never got a chance to report.
RUN sed -i '/<head>/r diag-overlay.html' dist/index.html \
 && grep -q '__reps_diag_overlay' dist/index.html \
 || (echo "diagnostic overlay injection failed" && exit 1)

# ── PWA install icons ─────────────────────────────────────────────────────────
# Metro web export only emits a small favicon, so an installed PWA upscales it
# and looks pixelated. Copy the manifest + high-res icons into the web root and
# reference them from <head>. (app.json uses web.output "single", so +html.tsx
# is not applied — inject the tags into the built index.html instead.)
RUN cp -r public/* dist/ 2>/dev/null || true \
 && sed -i 's|</head>|<link rel="manifest" href="/manifest.webmanifest"/><link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png"/><link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><meta name="theme-color" content="#4F46E5"/></head>|' dist/index.html \
 && grep -q 'manifest.webmanifest' dist/index.html \
 && test -f dist/icon-512.png && test -f dist/manifest.webmanifest \
 || (echo "PWA icon/manifest injection failed" && exit 1)

# ── Stage 2: serve with Nginx ─────────────────────────────────────────────────
FROM nginx:stable-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
