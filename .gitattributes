# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto

# Source & config — always LF in the repo
*.java   text eol=lf
*.kt     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
Dockerfile* text eol=lf
Caddyfile text eol=lf

# Unix shell / wrapper scripts must stay LF or they break on Linux
*.sh    text eol=lf
mvnw    text eol=lf
gradlew text eol=lf

# Windows scripts must stay CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.jar   binary
*.keystore binary
*.pdf   binary
