# PostgreSQL
POSTGRES_DB=reps
POSTGRES_USER=reps
POSTGRES_PASSWORD=change_me

# JWT
JWT_SECRET=change-me-in-production-minimum-256-bit-key-here
JWT_EXPIRATION_MS=2592000000

# Frontend (prod): baked into the web bundle at build time
EXPO_PUBLIC_API_URL=https://repstracker.no/api

# Domeneshop Dynamic DNS (only needed if home IP is dynamic)
# Create an API token at https://www.domeneshop.no/admin?view=api
DOMENESHOP_TOKEN=change_me
DOMENESHOP_SECRET=change_me
DDNS_HOSTNAME=repstracker.no
